{
  "name": "@opper/ai-sdk-provider",
  "version": "0.1.0",
  "description": "AI SDK provider for Opper — use any model through the Vercel AI SDK",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "prepublishOnly": "npm run build",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@ai-sdk/provider": "^3.0.3",
    "@ai-sdk/provider-utils": "^4.0.0",
    "zod": "^3.0.0"
  },
  "devDependencies": {
    "@ai-sdk/test-server": "^1.0.3",
    "@types/node": "^20.0.0",
    "ai": "^6.0.161",
    "typescript": "^5.3.0",
    "vitest": "^4.1.4"
  },
  "peerDependencies": {
    "ai": ">=4.0.0"
  },
  "keywords": [
    "opper",
    "ai-sdk",
    "vercel-ai",
    "llm",
    "openai-compatible",
    "ai-provider"
  ],
  "author": "Opper AI",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/opper-ai/ai-sdk-provider.git"
  },
  "homepage": "https://github.com/opper-ai/ai-sdk-provider#readme"
}
