{
  "name": "@opperai/ai-sdk-provider",
  "version": "0.1.1",
  "description": "Vercel AI SDK provider for Opper — run any model with a single API key",
  "license": "MIT",
  "author": "Opper AI",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "prepublishOnly": "npm run build && npm test",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@ai-sdk/openai-compatible": "^2.0.0",
    "@ai-sdk/provider": "^3.0.0",
    "@ai-sdk/provider-utils": "^4.0.0"
  },
  "devDependencies": {
    "@ai-sdk/test-server": "^1.0.3",
    "@types/node": "^20.0.0",
    "ai": "^6.0.0",
    "typescript": "^5.3.0",
    "vitest": "^4.1.4"
  },
  "peerDependencies": {
    "ai": ">=4.0.0"
  },
  "keywords": [
    "opper",
    "ai-sdk",
    "vercel-ai",
    "llm",
    "openai-compatible",
    "ai-provider",
    "ai",
    "llm-gateway"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/opper-ai/provider-ai-sdk.git"
  },
  "homepage": "https://github.com/opper-ai/provider-ai-sdk#readme",
  "bugs": {
    "url": "https://github.com/opper-ai/provider-ai-sdk/issues"
  }
}
